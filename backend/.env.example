# Production Deployment Environment Variables

# Database (Render PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT / Security
SECRET_KEY=your-super-secret-key-generate-a-long-random-string-here
DEBUG=false

# CORS Frontend
FRONTEND_URL=https://your-frontend.vercel.app

# Face model service
MODEL_SERVICE_URL=https://your-model-service-url.onrender.com
MODEL_SERVICE_TOKEN=generate-a-long-random-shared-secret
WEB_CONCURRENCY=1

# Set this on the model service, not the API service
LOAD_REAL_FACE_MODEL=true
