# Database
DATABASE_URL=postgresql://user:password@localhost:5432/connecting_dots

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AWS S3 (for photo storage)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_BUCKET_NAME=connecting-dots-photos
AWS_REGION=ap-south-1

# Firebase (push notifications)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Twilio (SMS alerts)
TWILIO_ACCOUNT_SID=your-sid
TWILIO_AUTH_TOKEN=your-token
TWILIO_PHONE_NUMBER=+1234567890

# Model paths
FACENET_MODEL_PATH=./data/models/facenet_model.pt
ARCFACE_MODEL_PATH=./data/models/arcface_model.pt
AGE_PROGRESSION_MODEL_PATH=./data/models/age_gan_generator.h5

# App
APP_ENV=development
LOG_LEVEL=INFO
