# ── Copy this to .env for local development ───────────────────────────────────
# On Cloud Run, set these as environment variables in the console

# Local SQLite (default — no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./connecting_dots.db

# Production PostgreSQL (Supabase) — uncomment and fill in for Cloud Run
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Change this to any long random string in production
SECRET_KEY=local-dev-key-change-for-production

# Your Vercel frontend URL (comma separated if multiple)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Set to false in production
DEBUG=true
